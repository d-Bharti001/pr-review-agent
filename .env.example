NODE_ENV=development
PORT=8081

# Database
# These ports are for running the app outside Docker; docker-compose.yml overrides host and port for the containers
MYSQL_HOST=localhost
MYSQL_PORT=8082
MYSQL_DATABASE=pr_review
MYSQL_USER=pr_review_user
MYSQL_PASSWORD=pr_review_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=8083

# GitHub App
GITHUB_APP_ID=
# Path to the App's private key (.pem). Under Docker it is overridden to the mounted ./secrets folder
GITHUB_PRIVATE_KEY_PATH="./secrets/private-key.pem"
# Must match the webhook secret set in the GitHub App settings
GITHUB_WEBHOOK_SECRET=

# LLM
# Provider: any one of "anthropic", "gemini", "ollama", "openai", "openrouter"
LLM_PROVIDER=
# Endpoint for the OpenAI-compatible providers (ollama, openai, openrouter). Leave empty for the provider's default.
# Ollama: http://localhost:11434/v1 (from Docker use http://host.docker.internal:11434/v1)
LLM_BASE_URL=
# Ollama ignores the key, but it must not be empty (use any value)
LLM_API_KEY=
# Must support tool calling and structured output. Very small models often fail at this
LLM_MODEL=
# Max estimated tokens of PR diff per batch; larger PRs are split into batches (about 60% of the model's context or per-minute token limit)
BATCH_TOKEN_BUDGET=30000

# LangSmith tracing (optional). To turn it off, remove LANGSMITH_TRACING or set it to false
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-reviewer
# Region of LangSmith account; a key from another region gets 403 errors
LANGSMITH_ENDPOINT="https://apac.api.smith.langchain.com"
